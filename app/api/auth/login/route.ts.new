import { NextResponse } from "next/server";
import db from "@/lib/db";
import bcrypt from "bcrypt";

// Define types for database results
interface UserResult {
  id?: number;
  ID?: number;
  email?: string;
  EMAIL?: string;
  password?: string;
  PASSWORD?: string;
  name?: string;
  NAME?: string;
  userType?: string;
  status?: number; // STATUS is now BOOLEAN (0 or 1) in the database
  STATUS?: number;
  [key: string]: unknown; // For other properties that may vary between user types
}

// Helper functions for validation
function isValidEmail(email: string): boolean {
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return emailRegex.test(email);
}

const loginAttempts: Record<string, { count: number; lastAttempt: number }> = {};

// Rate limiting function
function checkRateLimit(email: string): { allowed: boolean; message?: string } {
  const now = Date.now();
  const windowMs = 15 * 60 * 1000; // 15 minutes
  const maxAttempts = 5;

  // Clean up old entries
  Object.keys(loginAttempts).forEach((key) => {
    if (now - loginAttempts[key].lastAttempt > windowMs) {
      delete loginAttempts[key];
    }
  });

  // Check if this email has exceeded attempts
  if (!loginAttempts[email]) {
    loginAttempts[email] = { count: 1, lastAttempt: now };
    return { allowed: true };
  }

  // If within time window, check count
  if (loginAttempts[email].count >= maxAttempts) {
    const timeLeft = Math.ceil((windowMs - (now - loginAttempts[key].lastAttempt)) / 60000);
    return {
      allowed: false,
      message: `Too many login attempts. Please try again in ${timeLeft} minutes.`,
    };
  }

  // Increment count and update time
  loginAttempts[email].count += 1;
  loginAttempts[email].lastAttempt = now;
  return { allowed: true };
}

// Get normalized field value, handling case sensitivity
function getNormalizedField<T>(obj: UserResult, fieldName: string, defaultValue: T): T {
  const lowercaseField = fieldName.toLowerCase();
  const uppercaseField = fieldName.toUpperCase();
  const capitalizedField = fieldName.charAt(0).toUpperCase() + fieldName.slice(1).toLowerCase();
  
  // Check all possible case variations
  if (lowercaseField in obj) return obj[lowercaseField] as T;
  if (uppercaseField in obj) return obj[uppercaseField] as T;
  if (capitalizedField in obj) return obj[capitalizedField] as T;
  
  return defaultValue;
}

export async function POST(request: Request) {
  try {
    const { email, password } = await request.json();

    // Validate required fields
    if (!email || !password) {
      return NextResponse.json(
        { error: "Email and password are required" },
        { status: 400 },
      );
    }

    // Validate email format
    if (!isValidEmail(email)) {
      return NextResponse.json({ error: "Invalid email format" }, { status: 400 });
    }

    // Check password minimum length
    if (password.length < 8) {
      return NextResponse.json(
        { error: "Password must be at least 8 characters" },
        { status: 400 },
      );
    }

    // Check rate limiting
    const rateCheck = checkRateLimit(email);
    if (!rateCheck.allowed) {
      return NextResponse.json({ error: rateCheck.message }, { status: 429 });
    }

    // Determine which table to query based on the role or default to checking all tables
    let user: UserResult | null = null;
    let userTable = "";

    try {
      // First check in student table
      const studentQuery = "SELECT * FROM student WHERE EMAIL = ?";
      const students: UserResult[] = await new Promise((resolve, reject) => {
        db.query(studentQuery, [email], (err, results) => {
          if (err) {
            console.error("Student query error:", err);
            reject(err);
            return;
          }
          console.log("Student query results:", results);
          resolve(results as UserResult[]);
        });
      });

      if (students && Array.isArray(students) && students.length > 0) {
        const rawUser = students[0];
        // Normalize user fields
        user = {
          id: getNormalizedField(rawUser, "id", 0),
          email: getNormalizedField(rawUser, "email", ""),
          password: getNormalizedField(rawUser, "password", ""),
          name: getNormalizedField(rawUser, "name", ""),
          userType: "student",
          status: getNormalizedField(rawUser, "status", 0),
        };
        userTable = "student";
        console.log("Found student user:", { ...user, password: "[HIDDEN]" });
      }

      // If not found in student, check in admin table
      if (!user) {
        const adminQuery = "SELECT * FROM admin WHERE EMAIL = ?";
        const admins: UserResult[] = await new Promise((resolve, reject) => {
          db.query(adminQuery, [email], (err, results) => {
            if (err) {
              console.error("Admin query error:", err);
              reject(err);
              return;
            }
            console.log("Admin query results:", results);
            resolve(results as UserResult[]);
          });
        });

        if (admins && Array.isArray(admins) && admins.length > 0) {
          const rawUser = admins[0];
          user = {
            id: getNormalizedField(rawUser, "id", 0),
            email: getNormalizedField(rawUser, "email", ""),
            password: getNormalizedField(rawUser, "password", ""),
            name: getNormalizedField(rawUser, "name", ""),
            userType: "admin",
            status: getNormalizedField(rawUser, "status", 1), // Default admin to active
          };
          userTable = "admin";
          console.log("Found admin user:", { ...user, password: "[HIDDEN]" });
        }
      }

      // If not found in admin, check in advisor table
      if (!user) {
        const advisorQuery = "SELECT * FROM advisor WHERE EMAIL = ?";
        const advisors: UserResult[] = await new Promise((resolve, reject) => {
          db.query(advisorQuery, [email], (err, results) => {
            if (err) {
              console.error("Advisor query error:", err);
              reject(err);
              return;
            }
            console.log("Advisor query results:", results);
            resolve(results as UserResult[]);
          });
        });

        if (advisors && Array.isArray(advisors) && advisors.length > 0) {
          const rawUser = advisors[0];
          user = {
            id: getNormalizedField(rawUser, "id", 0),
            email: getNormalizedField(rawUser, "email", ""),
            password: getNormalizedField(rawUser, "password", ""),
            name: getNormalizedField(rawUser, "name", ""),
            userType: "advisor",
            status: 1, // Default advisor to active
          };
          userTable = "advisor";
          console.log("Found advisor user:", { ...user, password: "[HIDDEN]" });
        }
      }
    } catch (dbError) {
      console.error("Database query error:", dbError);
      return NextResponse.json(
        { error: "Database error", details: String(dbError) },
        { status: 500 }
      );
    }

    // Check if user exists in any table
    if (!user) {
      return NextResponse.json(
        { error: "Invalid email or password" },
        { status: 401 },
      );
    }

    // Ensure we have a password to compare against
    const hashedPassword = user.password;
    if (!hashedPassword || typeof hashedPassword !== 'string') {
      console.error("No valid password found in user record");
      return NextResponse.json(
        { error: "Authentication error - invalid user data" },
        { status: 500 },
      );
    }

    try {
      // Compare passwords with enhanced error handling
      console.log("Comparing passwords:", { 
        inputType: typeof password,
        inputLength: password.length,
        hashedType: typeof hashedPassword,
        hashedLength: hashedPassword.length
      });
      
      const passwordMatch = await bcrypt.compare(password, hashedPassword);
      console.log("Password match result:", passwordMatch);
      
      if (!passwordMatch) {
        return NextResponse.json(
          { error: "Invalid email or password" },
          { status: 401 },
        );
      }
    } catch (bcryptError) {
      console.error("Bcrypt comparison error:", bcryptError);
      return NextResponse.json(
        { 
          error: "Password verification failed", 
          details: String(bcryptError)
        },
        { status: 500 },
      );
    }

    // Check account status for students - now using numeric values (0 = inactive, 1 = active)
    if (userTable === "student" && user.status !== 1) {
      let message = "Your account is pending activation by the Head of Department.";
      if (user.status === 0) {
        message = "Your account has been deactivated. Please contact administration.";
      }
      
      // Map boolean status to string status for frontend compatibility
      const statusString = user.status === 0 ? "inactive" : "pending";
      
      return NextResponse.json(
        {
          error: "Account not activated",
          message,
          redirectTo: "/registration-status",
          status: statusString,
        },
        { status: 403 },
      );
    }

    // Return user data without sensitive information
    const { password: passwordField, ...userData } = user;

    return NextResponse.json({
      status: "success",
      message: "Login successful",
      user: {
        ...userData,
        userType: userTable, // Include the user type in the response
      },
    });
  } catch (error) {
    console.error("Login error:", error);
    return NextResponse.json(
      {
        status: "error",
        message: "Login failed",
        error: String(error),
      },
      { status: 500 },
    );
  }
}
